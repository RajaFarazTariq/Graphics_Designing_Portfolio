    "profile": [
      {
        "id": 1,
        "full_name": "Aatiqa Aslam",
        "job_title": "Creative Graphic Designer",
        "signature_role": "Creative Director",
        "availability_status": "Available for freelance · 2026",
        "short_intro": "a creative graphic designer building thoughtful logos, brand identities, and social media content from my studio in Islamabad, for clients worldwide.",
        "bio_lead": "Hi, I'm Aatiqa — a passionate graphic designer working remotely as a freelancer, helping individuals and small businesses bring their visual ideas to life from logos to social media to polished cover letters.",
        "bio": "My work focuses on clarity, balance, and a clean modern aesthetic. I believe good design isn't just about looking nice — it's about communicating a message clearly and confidently. Every project, big or small, gets the same care and attention to detail.",
        "philosophy_title": "Design Philosophy",
        "philosophy_quote": "\"Design is intelligence made visible. I create with intention — every line, color, and curve serves the story.\"",
        "city": "Islamabad",
        "country_code": "PK",
        "email": "aatiqaaslam14@gmail.com",
        "phone_display": "0315-5299918",
        "phone_intl": "+92-315-5299918",
        "website": "https://aatiqaaslam.com/",
        "working_mode": "Remote · Worldwide",
        "profile_media_id": null,
        "updated_at": "2026-09-24 22:23:07"
